# Copy to .env and fill in ONE provider. Never commit .env.
# The LLM only narrates results; screening and scoring run without it.

# Which provider to use: argo | openai | anthropic
LLM_PROVIDER=argo

# Seconds before any provider request is abandoned.
LANTERN_TIMEOUT=25


# --- argo (Argonne gateway; requires ANL network access) ---------------------
ARGO_BASE_URL=https://apps.inside.anl.gov/argoapi/v1
# Your ANL domain username -- Argo authenticates a username, not a secret API
# key. ARGO_API_KEY is the former name and is still read as a fallback.
ARGO_USER=
# Exactly as Argo lists it, e.g. "Claude Sonnet 5" or "GPT-5.1".
# See: curl -s $ARGO_BASE_URL/models
ARGO_MODEL=


# --- openai ------------------------------------------------------------------
# A real secret, unlike ARGO_USER. Treat it accordingly.
OPENAI_API_KEY=
# Optional; defaults to gpt-4o. The sidebar health check names the model if
# this id has been retired, which is the usual reason a key "stops working".
OPENAI_MODEL=
# Only needed for a proxy or an OpenAI-compatible third party.
OPENAI_BASE_URL=https://api.openai.com/v1


# --- anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
