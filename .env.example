# Copy to .env and fill in ONE provider. Never commit .env.
# The LLM only narrates results; screening and scoring run without it.

# Which provider to use: argo | openai | anthropic
LLM_PROVIDER=argo

# Seconds before any provider request is abandoned.
LANTERN_TIMEOUT=25


# --- argo (Argonne gateway) --------------------------------------------------
# Requires an approved account AND the ANL internal network: on-site, or VPN
# from an ANL-managed machine. Access is granted by your DOO or Directorate AI
# Rep (https://my.anl.gov/ai-at-argonne). Nothing here is a secret, but the
# whole provider is unreachable from an ordinary internet connection, which is
# why openai/anthropic exist below as alternatives.
ARGO_BASE_URL=https://apps.inside.anl.gov/argoapi/v1
# Your ANL domain username -- Argo authenticates a username, not a secret API
# key. Username only: no @anl.gov, no quotes, no other punctuation. "ac."
# accounts are not authorised. A service account name works too.
# ARGO_API_KEY is the former name and is still read as a fallback.
ARGO_USER=
# Leave blank to use the default, gpt56terra. Either spelling works: the Argo
# docs list compact ids ("claudeopus5", "gpt51") and the gateway's own /models
# answers in display names ("Claude Opus 5", "GPT-5.1"). Both were sent to the
# live gateway and both answered, so write whichever you have to hand. The full
# list, as the gateway spells it:
#   curl -s $ARGO_BASE_URL/models
# Compact ids currently include: gpt56sol gpt56terra gpt56luna gpt55 gpt54
#   gpt51 gpt5 gpt4o gpto3mini claudeopus5 claudesonnet5 claudehaiku45
#   gemini35flash
ARGO_MODEL=


# --- openai ------------------------------------------------------------------
# A real secret, unlike ARGO_USER. Treat it accordingly.
OPENAI_API_KEY=
# Optional; defaults to gpt-4o. The sidebar health check names the model if
# this id has been retired, which is the usual reason a key "stops working".
OPENAI_MODEL=
# Only needed for a proxy or an OpenAI-compatible third party.
OPENAI_BASE_URL=https://api.openai.com/v1


# --- anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
